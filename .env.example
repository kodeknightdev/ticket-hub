# Local development only. Copy to .env and adjust; .env is git-ignored.
COMPOSE_PROJECT_NAME=ticket-hub
# macOS uses port 5000 for AirPlay Receiver; change this if the ticketing BFF can't bind it
TICKETING_BFF_PORT=5000

# SQL Server: sa password plus one login per service database
MSSQL_SA_PASSWORD=LocalDev_Sa_Passw0rd!
IDENTITY_DB_PASSWORD=LocalDev_Identity_Pw1!
EVENTS_DB_PASSWORD=LocalDev_Events_Pw1!
SEATING_DB_PASSWORD=LocalDev_Seating_Pw1!
ORDERS_DB_PASSWORD=LocalDev_Orders_Pw1!
NOTIFIER_DB_PASSWORD=LocalDev_Notifier_Pw1!
PRICING_DB_PASSWORD=LocalDev_Pricing_Pw1!
ANALYTICS_DB_PASSWORD=LocalDev_Analytics_Pw1!

# Signing keys for local tokens and ticket QR codes (any long random string)
JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-me-0123456789
TICKET_SIGNING_KEY=local-dev-ticket-signing-key-change-me-0123456789
MOCK_WEBHOOK_SECRET=mock_whsec_local_dev

# Stripe TEST MODE only. Leave the placeholders to use the built-in mock payment provider.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Password for the demo accounts created by the Development seeder (local demo data, not a real credential)
SEED_DEMO_PASSWORD=Demo@12345
