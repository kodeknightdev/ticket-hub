{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Bff": {
    "AppName": "dash",
    "CookieName": "__Host-tickethub-dash",
    "FrontendOrigin": "http://localhost:3100",
    "IdentityUrl": "http://localhost:5201",
    "SessionHours": 8,
    "AllowedRoles": [ "Owner", "Organizer", "Admin" ]
  },
  "Services": {
    "Analytics": "http://localhost:8002",
    "Events": "http://localhost:5202",
    "Pricing": "http://localhost:8001",
    "Orders": "http://localhost:5204",
    "SeatingGrpc": "http://localhost:5213"
  },
  "RateLimits": {
    "ExportsPerMinute": 5
  },
  "ReverseProxy": {
    "Routes": {
      "venues": {
        "ClusterId": "events",
        "AuthorizationPolicy": "bff-user",
        "Match": { "Path": "/api/venues", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "categories": {
        "ClusterId": "events",
        "AuthorizationPolicy": "bff-user",
        "Match": { "Path": "/api/categories", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "events": { "Destinations": { "primary": { "Address": "http://localhost:5202" } } }
    }
  }
}
