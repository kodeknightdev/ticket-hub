{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Bff": {
    "AppName": "app",
    "CookieName": "__Host-tickethub-app",
    "FrontendOrigin": "http://localhost:3000",
    "IdentityUrl": "http://localhost:5201",
    "SessionHours": 8,
    "AllowedRoles": []
  },
  "Services": {
    "Events": "http://localhost:5202",
    "SeatingGrpc": "http://localhost:5213",
    "Orders": "http://localhost:5204",
    "Pricing": "http://localhost:8001"
  },
  "RateLimits": {
    "HoldsPerWindow": 10,
    "WindowSeconds": 30
  },
  "ReverseProxy": {
    "Routes": {
      "events": {
        "ClusterId": "events",
        "Match": { "Path": "/api/events/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "events-root": {
        "ClusterId": "events",
        "Match": { "Path": "/api/events" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "venues": {
        "ClusterId": "events",
        "Match": { "Path": "/api/venues", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "categories": {
        "ClusterId": "events",
        "Match": { "Path": "/api/categories", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "holds-create": {
        "ClusterId": "seating",
        "Order": 1,
        "AuthorizationPolicy": "bff-user",
        "RateLimiterPolicy": "holds",
        "Match": { "Path": "/api/seating/holds", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "seating": {
        "ClusterId": "seating",
        "Order": 2,
        "Match": { "Path": "/api/seating/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "bff-user",
        "Match": { "Path": "/api/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "orders-root": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "bff-user",
        "Match": { "Path": "/api/orders" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "tickets": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "bff-user",
        "Match": { "Path": "/api/tickets/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "checkin": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "bff-user",
        "Match": { "Path": "/api/checkin", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "prices": {
        "ClusterId": "pricing",
        "Match": { "Path": "/api/prices/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "seating-hub": {
        "ClusterId": "seating",
        "Match": { "Path": "/hubs/seating/{**rest}" }
      }
    },
    "Clusters": {
      "events": { "Destinations": { "primary": { "Address": "http://localhost:5202" } } },
      "seating": {
        "SessionAffinity": { "Enabled": true, "Policy": "Cookie", "AffinityKeyName": ".TicketHub.Seating.Affinity" },
        "Destinations": { "primary": { "Address": "http://localhost:5203" } }
      },
      "orders": { "Destinations": { "primary": { "Address": "http://localhost:5204" } } },
      "pricing": { "Destinations": { "primary": { "Address": "http://localhost:8001" } } }
    }
  }
}
