{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=TicketHub_Identity;User Id=identity_svc;Password=__set_in_env__;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "tickethub-identity",
    "Audience": "tickethub",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
