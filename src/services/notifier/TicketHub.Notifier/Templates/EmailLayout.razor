<div style="font-family: Arial, Helvetica, sans-serif; background:#f4f4f7; padding:24px;">
    <div style="max-width:560px; margin:0 auto; background:#ffffff; border-radius:8px; overflow:hidden;">
        <div style="background:#1f1b4d; color:#ffffff; padding:16px 24px; font-size:20px; font-weight:bold;">ticket-hub</div>
        <div style="padding:24px; color:#222; font-size:15px; line-height:1.5;">
            <h2 style="margin-top:0;">@Heading</h2>
            @ChildContent
        </div>
        <div style="padding:12px 24px; color:#888; font-size:12px; border-top:1px solid #eee;">
            This is a local demo email captured by MailHog. No real tickets were sold.
        </div>
    </div>
</div>

@code {
    [Parameter] public string Heading { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
