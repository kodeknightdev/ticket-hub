{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=TicketHub_Notifier;User Id=notifier_svc;Password=__set_in_env__;TrustServerCertificate=True"
  },
  "Kafka": { "BootstrapServers": "localhost:9092" },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "tickets@tickethub.local",
    "FromName": "ticket-hub"
  }
}
