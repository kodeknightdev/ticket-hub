{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1AndHttp2" },
      "Grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=TicketHub_Seating;User Id=seating_svc;Password=__set_in_env__;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Kafka": { "BootstrapServers": "localhost:9092" },
  "Services": { "Events": "http://localhost:5202" },
  "Seating": {
    "HoldSeconds": 600,
    "MaxSeatsPerHold": 8,
    "WarnSecondsBeforeExpiry": 120
  },
  "Jwt": { "Issuer": "tickethub-identity", "Audience": "tickethub", "SigningKey": "" }
}
